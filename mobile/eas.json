{
  "cli": {
    "version": ">= 16.23.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
    
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "environment": "preview",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_CUSTOM_AUTH_ENABLED": "true",
        "EXPO_PUBLIC_BFF_REQUIRED": "true",
        "EXPO_PUBLIC_API_BASE_URL": "https://elidzconnect-8duyrt214-tebogolekgothoane5-gmailcoms-projects.vercel.app",
        "EXPO_PUBLIC_APP_WEB_URL": "https://elidzconnect-8duyrt214-tebogolekgothoane5-gmailcoms-projects.vercel.app",
        "SENTRY_ALLOW_FAILURE": "true",
        "EXPO_PUBLIC_USE_CHAT_POLL": "false",
        "EXPO_PUBLIC_USE_BFF_UPLOADS": "false"
      }
    },
    "preview-bff": {
      "extends": "preview",
      "channel": "preview-bff",
      "env": {
        "EXPO_PUBLIC_CUSTOM_AUTH_ENABLED": "true",
        "EXPO_PUBLIC_BFF_REQUIRED": "true",
        "EXPO_PUBLIC_USE_CHAT_POLL": "true",
        "EXPO_PUBLIC_USE_BFF_UPLOADS": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "environment": "production",
      "channel": "production",
      "env": {
        "EAS_BUILD_DISABLE_NPM_CACHE": "1"
      }
    },
    "production-huawei": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "channel": "production-huawei",
      "env": {
        "EAS_BUILD_DISABLE_NPM_CACHE": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
