{
  "cli": {
    "version": ">= 16.23.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
    
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "environment": "preview",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "environment": "production",
      "channel": "production",
      "env": {
        "EAS_BUILD_DISABLE_NPM_CACHE": "1"
      }
    },
    "production-huawei": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "channel": "production-huawei",
      "env": {
        "EAS_BUILD_DISABLE_NPM_CACHE": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
