# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# Project JWT secret (Dashboard → Settings → API) — Realtime/Storage data tokens only
SUPABASE_JWT_SECRET=

# Custom auth (required for /api/auth/*)
# Generate: openssl rand -base64 48
AUTH_JWT_SECRET=
# Optional pepper (openssl rand -base64 32) — keep outside DB/source control
AUTH_PEPPER=
# Server cutover switch (default off — keep Supabase Auth). Not a security boundary.
CUSTOM_AUTH_ENABLED=false
# AUTH_PROVIDER=custom  # alternative to CUSTOM_AUTH_ENABLED=true
# Client UI mirror (must match server for admin login forms)
NEXT_PUBLIC_CUSTOM_AUTH_ENABLED=false

# OAuth (comma-separated allowed audiences)
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# Public URLs (local: http://localhost:3000 — staging: your stable Vercel Preview URL)
APP_PUBLIC_URL=http://localhost:3000
EXPO_PUBLIC_APP_WEB_URL=

# SMTP via Resend (required for real password-reset / verification email)
# SMTP_PASSWORD = Resend API key (re_...)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM=onboarding@resend.dev
